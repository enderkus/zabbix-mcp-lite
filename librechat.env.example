# LibreChat settings. Copy to librechat.env and fill in.
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://librechat-mongodb:27017/LibreChat
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
NO_INDEX=true
TZ=UTC

# Secrets - generate each one:
#   CREDS_KEY:          openssl rand -hex 32
#   CREDS_IV:           openssl rand -hex 16
#   JWT_SECRET:         openssl rand -hex 32
#   JWT_REFRESH_SECRET: openssl rand -hex 32
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Login: the first registered user becomes admin.
# Set ALLOW_REGISTRATION=false after creating your account.
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
SEARCH=false

# LM Studio needs no key; any placeholder works
LMSTUDIO_API_KEY=lm-studio

# Zabbix API token of the read-only mcp-reader user (written by setup_zabbix.py)
ZABBIX_MCP_TOKEN=

# Single container, no Redis: lets the scheduler start
SCHEDULES_SINGLE_PROCESS=true
