# Docker Compose variables. Copy to .env and fill in.

# Zabbix PostgreSQL password, e.g.: openssl rand -hex 16
ZBX_DB_PASSWORD=change-me

# Time zone for Zabbix and zabbix-mcp-lite (IANA name)
TZ=UTC

# Address for the Zabbix web UI and LibreChat ports.
# 127.0.0.1 = this machine only; 0.0.0.0 = whole network (change the default passwords first)
BIND_ADDR=127.0.0.1
